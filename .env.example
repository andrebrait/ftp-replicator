# Copy to .env and fill in. Never commit the real one (.gitignore covers it).

# ── Backup SFTP remote, referred to as "backup:" everywhere ──
RCLONE_CONFIG_BACKUP_TYPE=sftp
RCLONE_CONFIG_BACKUP_HOST=backup.example.internal
RCLONE_CONFIG_BACKUP_PORT=2022
RCLONE_CONFIG_BACKUP_USER=replicator
# OBSCURED, not plaintext: rclone obscure 'the-password'
RCLONE_CONFIG_BACKUP_PASS=REPLACE_WITH_OBSCURED_PASSWORD
# Without this, rclone accepts whatever host key is presented and says so on every run.
# ssh-keyscan -p 2022 backup.example.internal > backup_known_hosts
RCLONE_CONFIG_BACKUP_KNOWN_HOSTS_FILE=/known_hosts

# ── Event daemon ──
SYNC_SRC=/data/source
SYNC_DEST=backup:
SYNC_DAEMON_PORT=8787
SYNC_QUIET_PERIOD=2
SYNC_FLUSH_INTERVAL=1
# Must stay BELOW the sweep's MIN_AGE, so the daemon has given up on a file
# before the sweep starts considering it.
SYNC_MAX_ENTRY_AGE=290
SYNC_RCLONE_TIMEOUT=900

# ── Reconciliation sweep ──
SYNC_INTERVAL=300
MIN_AGE=5m

# ── Orphan reaper ──
# BOTH must point at the level that DIRECTLY contains the date directories, and at
# the same level as each other. Point them too high and every remote file looks
# remote-only (harmless, since deleting needs a local twin, but useless); the
# script logs a WARNING when it sees that shape.
REAP_SRC=/data/source
REAP_REMOTE=backup:/
REAP_DAYS=2

# ── Mail (sweep reports and failure alerts; the daemon never mails) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=REPLACE_ME
MAIL_FROM=alerts@example.com
MAIL_TO=you@example.com
